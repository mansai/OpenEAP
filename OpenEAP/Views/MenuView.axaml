<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:atom="https://atomui.net"
			 xmlns:icon="https://atomui.net/icons/antdesign"
			 xmlns:model="using:OpenEAP.Model"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="OpenEAP.Views.MenuView" x:DataType="MenuViewModel">
	<Grid RowDefinitions="auto,*">
		<WrapPanel Margin="{DynamicResource DefaultMargin}">
			<atom:Space>
				<atom:Button Icon="{icon:AntDesignIconProvider PlusCircleOutlined}" Content="{L Add}" Command="{Binding Add}" ></atom:Button>
				<atom:Button Icon="{icon:AntDesignIconProvider SaveOutlined}" Content="{L Save}" Command="{Binding Save}"></atom:Button>
				<atom:Button Icon="{icon:AntDesignIconProvider CopyOutlined}" Content="{L Copy}" Command="{Binding Copy}"></atom:Button>
				<atom:PopupConfirm Title="{L Tips}" ConfirmContent="{L DeleteConfirm}" OkText="{L ButtonOk}" CancelText="{L ButtonCancel}" Placement="Bottom" IsArrowVisible="True">
					<Interaction.Behaviors>
						<EventTriggerBehavior EventName="Confirmed">
							<CallMethodAction MethodName="Delete_Confirmed" TargetObject="{Binding $self.DataContext}" />
						</EventTriggerBehavior>
					</Interaction.Behaviors>
					<atom:Button Icon="{icon:AntDesignIconProvider DeleteOutlined}" Content="{L Delete}" IsDanger="True"></atom:Button>
				</atom:PopupConfirm>
			</atom:Space>
		</WrapPanel>
		<DataGrid Grid.Row="1" ItemsSource="{Binding MenuEntity}"
				  CanUserResizeColumns="True"
				  CanUserReorderColumns="True"
				  CanUserSortColumns="True"
				  CanUserReorderRows="True"
				  CanUserDeleteRows="False"
				  CanUserAddRows="False"
				  HeadersVisibility="All" SelectedIndex="{Binding SelectedIndex}">
			<DataGrid.Columns>
				<DataGridTextColumn Header="{L Name}" Binding="{Binding Name}" Width="*" />
				<DataGridTextColumn Header="{L Namespace}" Binding="{Binding Namespace}" Width="*" />
				<DataGridTextColumn Header="{L Form}" Binding="{Binding Form}" Width="*" />
				<DataGridTextColumn Header="{L Language}" Binding="{Binding LanguageKey}" Width="*" />
				<DataGridTextColumn Header="{L Icon}" Binding="{Binding Icon}" Width="*" />
				<DataGridCheckBoxColumn Header="{L Enable}" Binding="{Binding Enable}" Width="*" />
				<DataGridTextColumn Header="{L CreationTime}" Binding="{Binding CreationTime}" Width="*" />
			</DataGrid.Columns>
		</DataGrid>
	</Grid>
</UserControl>
