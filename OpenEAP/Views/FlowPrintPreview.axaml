<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:icon="https://atomui.net/icons/antdesign"
             x:Class="OpenEAP.Views.FlowPrintPreview"
             Title="{L FlowPrintPreview}"
             Width="1120" Height="820"
             MinWidth="860" MinHeight="620"
             WindowStartupLocation="CenterOwner"
             RequestedThemeVariant="Light"
             Background="#E8EDF4">
    <Window.Styles>
        <Style Selector="FlyoutPresenter.printer-flyout">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D8E0EB" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,230,Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
                <TextBlock Text="{L FlowPrinter}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                <Button x:Name="PrinterButton" Grid.Column="1" Margin="10,0,18,0"
                        Height="34" Padding="10,0" Background="#F8FAFC"
                        BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="7"
                        Foreground="#1F2937" HorizontalContentAlignment="Stretch"
                        ToolTip.Tip="{L FlowSelectPrinter}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="PrinterNameText" Text="{L FlowNoPrinter}"
                                   FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="⌄" FontSize="12" Margin="8,0,0,0"
                                   Foreground="#64748B" VerticalAlignment="Center" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="printer-flyout">
                            <Border Width="340" Background="#FFFFFF" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="8" Padding="5">
                                <ListBox x:Name="PrinterList" Background="#FFFFFF"
                                         Foreground="#1F2937" MaxHeight="300"
                                         SelectionMode="Single"
                                         SelectionChanged="OnPrinterSelectionChanged">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Foreground" Value="#1F2937" />
                                            <Setter Property="Padding" Value="10,7" />
                                            <Setter Property="MinHeight" Value="32" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="#EFF6FF" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="#DBEAFE" />
                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="2" Text="{L FlowOrientation}" FontSize="12" Foreground="#475569" VerticalAlignment="Center" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9"
                            Margin="10,0,18,0" VerticalAlignment="Center">
                    <RadioButton x:Name="AutoOrientation" GroupName="PrintOrientation"
                                 Content="{L FlowAuto}" IsChecked="True" FontSize="12"
                                 Foreground="#475569" IsCheckedChanged="OnOrientationChanged" />
                    <RadioButton x:Name="PortraitOrientation" GroupName="PrintOrientation"
                                 Content="{L FlowPortrait}" FontSize="12" Foreground="#475569"
                                 IsCheckedChanged="OnOrientationChanged" />
                    <RadioButton x:Name="LandscapeOrientation" GroupName="PrintOrientation"
                                 Content="{L FlowLandscape}" FontSize="12" Foreground="#475569"
                                 IsCheckedChanged="OnOrientationChanged" />
                </StackPanel>
                <TextBlock x:Name="PageInfoText" Grid.Column="4" Text="{L FlowPreview}" FontSize="11.5"
                           Foreground="#64748B" VerticalAlignment="Center" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                    <atom:Button x:Name="PrintButton" ButtonType="Primary" Content="{L FlowPrintButton}"
                                 Icon="{icon:AntDesignIconProvider PrinterOutlined}"
                                 CornerRadius="7" Padding="14,7" Click="OnPrintClick" />
                    <atom:Button Content="{L FlowClose}" CornerRadius="7" Padding="14,7" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="28">
            <Grid x:Name="PageHost" SizeChanged="OnPageHostSizeChanged">
                <Border x:Name="PageBorder" Background="#FFFFFF" HorizontalAlignment="Center"
                        VerticalAlignment="Center" BoxShadow="0 12 34 0 #450F172A">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="18" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E0EB" BorderThickness="0,1,0,0"
                Padding="20,9">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText" Text="{L FlowPrintPreviewStatus}"
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{L FlowPrintSendHint}"
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</atom:Window>
