<atom:Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenEAP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:atom="https://atomui.net"
		xmlns:icon="https://atomui.net/icons/antdesign"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="OpenEAP.Views.MediaPlayer"
        x:DataType="vm:MainViewModel"
        Title="{x:Null}"
        WindowState="Normal"
		IsFullScreenCaptionButtonVisible="True"
        WindowStartupLocation="CenterScreen">
	<atom:Window.LeftAddOn>
		<StackPanel Orientation="Horizontal" Spacing="10">
			<atom:Button ButtonType="Text" Icon="{icon:AntDesignIconProvider FolderOpenOutlined}" Click="Button_Click" />
			<!--<atom:Alert Type="Success" Message="双击播放器，实现打开功能" />-->
		</StackPanel>
	</atom:Window.LeftAddOn>
	<MediaPlayerControl Grid.Row="1" Name="mediaPlayerControl" Volume="0.8" LoadedBehavior="AutoPlay"  />
</atom:Window>
