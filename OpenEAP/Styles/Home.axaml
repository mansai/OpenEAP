<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <!-- 深色监控色板 -->
            <Color x:Key="HomeBgColor">#0D1520</Color>
            <Color x:Key="HomePanelColor">#141F2C</Color>
            <Color x:Key="HomePanel2Color">#182534</Color>
            <Color x:Key="HomeBorderColor">#24364A</Color>
            <Color x:Key="HomeTextColor">#D8E4EF</Color>
            <Color x:Key="HomeMutedColor">#7D92A6</Color>
            <Color x:Key="HomeAccentColor">#28C4E8</Color>
            <Color x:Key="HomeAccentDimColor">#16586A</Color>
            <Color x:Key="HomeOkColor">#34D399</Color>
            <Color x:Key="HomeWarnColor">#FBBF24</Color>
            <Color x:Key="HomeDangerColor">#F87171</Color>
            <Color x:Key="HomeOffColor">#5B6B7A</Color>
            <Color x:Key="HomeCodeColor">#0A111A</Color>

            <SolidColorBrush x:Key="HomeBgBrush" Color="{StaticResource HomeBgColor}" />
            <SolidColorBrush x:Key="HomePanel2Brush" Color="{StaticResource HomePanel2Color}" />
            <SolidColorBrush x:Key="HomeBorderBrush" Color="{StaticResource HomeBorderColor}" />
            <SolidColorBrush x:Key="HomeTextBrush" Color="{StaticResource HomeTextColor}" />
            <SolidColorBrush x:Key="HomeMutedBrush" Color="{StaticResource HomeMutedColor}" />
            <SolidColorBrush x:Key="HomeAccentBrush" Color="{StaticResource HomeAccentColor}" />
            <SolidColorBrush x:Key="HomeAccentDimBrush" Color="{StaticResource HomeAccentDimColor}" />
            <SolidColorBrush x:Key="HomeOkBrush" Color="{StaticResource HomeOkColor}" />
            <SolidColorBrush x:Key="HomeWarnBrush" Color="{StaticResource HomeWarnColor}" />
            <SolidColorBrush x:Key="HomeDangerBrush" Color="{StaticResource HomeDangerColor}" />
            <SolidColorBrush x:Key="HomeOffBrush" Color="{StaticResource HomeOffColor}" />
            <SolidColorBrush x:Key="HomeCodeBrush" Color="{StaticResource HomeCodeColor}" />

            <LinearGradientBrush x:Key="HomeCardBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource HomePanelColor}" Offset="0" />
                <GradientStop Color="#111C28" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HomePrimaryBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource HomeAccentColor}" Offset="0" />
                <GradientStop Color="#1B87A3" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HomeWarnGradBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource HomeWarnColor}" Offset="0" />
                <GradientStop Color="#D99A1C" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HomeOkGradBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource HomeOkColor}" Offset="0" />
                <GradientStop Color="#1F9D66" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HomeNgGradBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource HomeDangerColor}" Offset="0" />
                <GradientStop Color="#C5484D" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- 页面根 -->
    <Style Selector="UserControl.home-root">
        <Setter Property="Background" Value="{StaticResource HomeBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
    </Style>

    <!-- 卡片 -->
    <Style Selector="Border.home-card">
        <Setter Property="Background" Value="{StaticResource HomeCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.home-accent-bar">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource HomeAccentBrush}" />
    </Style>

    <!-- 文本 -->
    <Style Selector="TextBlock.home-card-title">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
    </Style>
    <Style Selector="TextBlock.home-hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource HomeMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.home-page-title">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
    </Style>
    <Style Selector="TextBlock.home-clock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
    </Style>
    <Style Selector="TextBlock.home-mono">
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style Selector="TextBlock.home-serial">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="Foreground" Value="#FFD479" />
    </Style>

    <!-- 按钮：自绘模板，深色统一 -->
    <Style Selector="Button.home-btn">
        <Setter Property="Background" Value="{StaticResource HomePanel2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.home-btn:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource HomeAccentBrush}" />
    </Style>
    <Style Selector="Button.home-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource HomeAccentBrush}" />
    </Style>

    <Style Selector="Button.home-primary">
        <Setter Property="Background" Value="{StaticResource HomePrimaryBrush}" />
        <Setter Property="Foreground" Value="#041018" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.home-warn">
        <Setter Property="Background" Value="{StaticResource HomeWarnGradBrush}" />
        <Setter Property="Foreground" Value="#241A04" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.home-ok">
        <Setter Property="Background" Value="{StaticResource HomeOkGradBrush}" />
        <Setter Property="Foreground" Value="#041018" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="44,20" />
    </Style>
    <Style Selector="Button.home-ng">
        <Setter Property="Background" Value="{StaticResource HomeNgGradBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="44,20" />
    </Style>
    <Style Selector="Button.home-num">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.home-clr">
        <Setter Property="Foreground" Value="{StaticResource HomeDangerBrush}" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- 机台行（整行可点） -->
    <Style Selector="Button.machine-item">
        <Setter Property="Background" Value="{StaticResource HomePanel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.machine-item:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{StaticResource HomeAccentBrush}" />
    </Style>
    <Style Selector="Button.machine-item.machine-sel">
        <Setter Property="BorderBrush" Value="{StaticResource HomeAccentBrush}" />
        <Setter Property="Background" Value="#141F33" />
    </Style>

    <!-- 已选 chip -->
    <Style Selector="Border.home-chip">
        <Setter Property="Background" Value="#1E3A44" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeAccentDimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

    <!-- 状态徽章 -->
    <Style Selector="Border.home-badge">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="Border.home-badge.run">
        <Setter Property="Background" Value="#182B26" />
    </Style>
    <Style Selector="Border.home-badge.pause">
        <Setter Property="Background" Value="#2B2412" />
    </Style>
    <Style Selector="Border.home-badge.stop">
        <Setter Property="Background" Value="#2B1A1A" />
    </Style>

    <!-- 图片区状态灯 -->
    <Style Selector="Border.home-light">
        <Setter Property="Background" Value="{StaticResource HomePanel2Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,2" />
    </Style>
    <Style Selector="Border.home-light.active">
        <Setter Property="Background" Value="{StaticResource HomeNgGradBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeDangerBrush}" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.35" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- 图片容器 -->
    <Style Selector="Border.home-img-box">
        <Setter Property="Background" Value="#06090D" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- 深色输入框 -->
    <Style Selector="TextBox.home-input">
        <Setter Property="Background" Value="{StaticResource HomeCodeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 缩放按钮 -->
    <Style Selector="Button.home-zoom">
        <Setter Property="Background" Value="#99131B26" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- DataGrid 深色覆盖 -->
    <Style Selector="DataGrid.home-table">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource HomeTextBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource HomeBorderBrush}" />
    </Style>
    <Style Selector="DataGrid.home-table DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HomePanel2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource HomeMutedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HomeBorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGrid.home-table DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#3A24364A" />
    </Style>
    <Style Selector="DataGrid.home-table DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="#0D28C4E8" />
    </Style>
    <Style Selector="DataGrid.home-table DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="#1F28C4E8" />
    </Style>
</Styles>
